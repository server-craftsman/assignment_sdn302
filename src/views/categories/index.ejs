<section class="categories">
  <h2>Browse Categories</h2>
  <div class="table-responsive">
    <table class="categories-table">
      <thead>
        <tr>
          <th>Category Name</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(category => { %>
        <tr>
          <td><%= category.name %></td>
          <td><%= category.description %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
